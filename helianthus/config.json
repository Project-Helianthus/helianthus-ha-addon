{
  "name": "Helianthus",
  "version": "0.6.55",
  "slug": "helianthus",
  "description": "Helianthus multi-runtime gateway (GraphQL + MCP)",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "host_network": true,
  "map": [
    "ssl:ro"
  ],
  "ports": {
    "8080/tcp": 8080,
    "8443/tcp": 8443
  },
  "ports_description": {
    "8080/tcp": "GraphQL + MCP HTTP server",
    "8443/tcp": "Dedicated canonical PV M2M HTTPS server"
  },
  "image": "ghcr.io/project-helianthus/helianthus-ha-addon",
  "options": {
    "adapter_direct_enabled": true,
    "adapter_direct_address": "",
    "proxy_listen_addr": "0.0.0.0:19001",
    "transport": "enh",
    "network": "tcp",
    "address": "HOST:PORT",
    "proxy_profile": "disabled",
    "proxy_endpoint": "",
    "host": "127.0.0.1",
    "port": 8080,
    "path": "/graphql",
    "http_port": 8080,
    "graphql_path": "/graphql",
    "subscription_path": "/graphql/subscriptions",
    "mcp_path": "/mcp",
    "mdns": true,
    "mdns_instance": "helianthus",
    "broadcast": true,
    "source_addr": "auto",
    "scan_request_timeout": "400ms",
    "read_timeout": "5s",
    "write_timeout": "5s",
    "dial_timeout": "5s",
    "observe_first_enabled": true,
    "passive_state_direct_apply": true,
    "passive_config_direct_apply": false,
    "external_write_policy": "record_only",
    "enable_static_seed_table": false,
    "v8_classifier_mode": "enforce",
    "eebus_enabled": false,
    "eebus_listen_port": 4712,
    "eebus_interface": "",
    "eebus_subnets": "",
    "eebus_discovery_enabled": true,
    "eebus_remote_ski_allowlist": "",
    "modbus_tcp_enabled": false,
    "modbus_tcp_endpoint": "",
    "modbus_tcp_dial_timeout": "5s",
    "m2m_graphql_enabled": false,
    "m2m_graphql_server_name": "",
    "m2m_graphql_asset_ref": ""
  },
  "schema": {
    "adapter_direct_enabled": "bool",
    "adapter_direct_protocol": "list(enh|ens)?",
    "adapter_direct_address": "str",
    "proxy_listen_addr": "str",
    "transport": "list(enh|ens|udp-plain|ebusd-tcp)",
    "network": "list(tcp|unix|udp)",
    "address": "str",
    "proxy_profile": "list(disabled|enh|ens)",
    "proxy_endpoint": "str",
    "host": "str",
    "port": "int",
    "path": "str",
    "http_port": "int",
    "graphql_path": "str",
    "subscription_path": "str",
    "mcp_path": "str",
    "mdns": "bool",
    "mdns_instance": "str",
    "broadcast": "bool",
    "source_addr": "str",
    "scan_request_timeout": "str",
    "read_timeout": "str",
    "write_timeout": "str",
    "dial_timeout": "str",
    "observe_first_enabled": "bool",
    "passive_state_direct_apply": "bool",
    "passive_config_direct_apply": "bool",
    "external_write_policy": "list(record_only|invalidate_only|record_and_invalidate)",
    "enable_static_seed_table": "bool",
    "v8_classifier_mode": "list(off|shadow|enforce)",
    "eebus_enabled": "bool",
    "eebus_listen_port": "int",
    "eebus_interface": "str",
    "eebus_subnets": "str",
    "eebus_discovery_enabled": "bool",
    "eebus_remote_ski_allowlist": "str",
    "modbus_tcp_enabled": "bool",
    "modbus_tcp_endpoint": "str",
    "modbus_tcp_dial_timeout": "str",
    "m2m_graphql_enabled": "bool",
    "m2m_graphql_server_name": "str",
    "m2m_graphql_asset_ref": "str"
  }
}
