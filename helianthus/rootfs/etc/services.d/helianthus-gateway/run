#!/usr/bin/with-contenv bashio

set -euo pipefail

legacy_modbus_health_file="/data/modbus-runtime-health.json"
if ! rm -f -- "${legacy_modbus_health_file}"; then
  bashio::exit.nok "Unable to remove retired Modbus runtime health record"
fi

transport=$(bashio::config 'transport')
network=$(bashio::config 'network')
address=$(bashio::config 'address')
proxy_profile=$(bashio::config 'proxy_profile')
proxy_endpoint=$(bashio::config 'proxy_endpoint')
host=$(bashio::config 'host')
port=$(bashio::config 'port')
path=$(bashio::config 'path')
http_port=$(bashio::config 'http_port')
graphql_path=$(bashio::config 'graphql_path')
subscription_path=$(bashio::config 'subscription_path')
mcp_path=$(bashio::config 'mcp_path')
mdns=$(bashio::config 'mdns')
mdns_instance=$(bashio::config 'mdns_instance')
broadcast=$(bashio::config 'broadcast')
source_addr=$(bashio::config 'source_addr')
scan_request_timeout=$(bashio::config 'scan_request_timeout')
read_timeout=$(bashio::config 'read_timeout')
write_timeout=$(bashio::config 'write_timeout')
dial_timeout=$(bashio::config 'dial_timeout')
adapter_direct_enabled=$(bashio::config 'adapter_direct_enabled' 2>/dev/null || true)
adapter_direct_protocol=$(bashio::config 'adapter_direct_protocol' 2>/dev/null || true)
adapter_direct_address=$(bashio::config 'adapter_direct_address' 2>/dev/null || true)
proxy_listen_addr=$(bashio::config 'proxy_listen_addr' 2>/dev/null || true)
# F-1 defensive fallback (EBUSD-VERIFICATION-2026-05-10.md): HA Supervisor's
# /addons/self/options/config endpoint has been observed silently returning
# empty for proxy_listen_addr despite the value being correctly stored in
# /data/options.json AND surfaced by /addons/local_helianthus/info. The
# Supervisor cache-invalidation bug appears specific to this key and reproduces
# only after the addon options POST without a container recreation. When
# bashio returns empty, parse the JSON directly via jq as the source of truth.
if [ -z "${proxy_listen_addr}" ] && [ -f /data/options.json ] && command -v jq >/dev/null 2>&1; then
  proxy_listen_addr_fallback=$(jq -r '.proxy_listen_addr // empty' /data/options.json 2>/dev/null || true)
  if [ -n "${proxy_listen_addr_fallback}" ] && [ "${proxy_listen_addr_fallback}" != "null" ]; then
    bashio::log.warning "bashio::config 'proxy_listen_addr' returned empty; falling back to /data/options.json (value=${proxy_listen_addr_fallback}). Supervisor cache-invalidation bug — see EBUSD-VERIFICATION-2026-05-10.md F-1."
    proxy_listen_addr="${proxy_listen_addr_fallback}"
  fi
fi
observe_first_enabled=$(bashio::config 'observe_first_enabled' 2>/dev/null || true)
passive_state_direct_apply=$(bashio::config 'passive_state_direct_apply' 2>/dev/null || true)
passive_config_direct_apply=$(bashio::config 'passive_config_direct_apply' 2>/dev/null || true)
external_write_policy=$(bashio::config 'external_write_policy' 2>/dev/null || true)
enable_static_seed_table=$(bashio::config 'enable_static_seed_table' 2>/dev/null || true)
# Step C / v8 frame-atomic-visibility: read the classifier mode option
# (off|shadow|enforce). Exported as HELIANTHUS_V8_CLASSIFIER_MODE env
# below so cmd/gateway/main.go's startup wiring (PR #651) picks it up.
v8_classifier_mode=$(bashio::config 'v8_classifier_mode' 2>/dev/null || true)

# Validate the Modbus bundle directly from the protected Supervisor options
# document before the gateway process is constructed. The helper emits only
# shell-quoted, type-checked values and reports failures without echoing the
# endpoint or any rejected credential material.
modbus_options_path="${HELIANTHUS_MODBUS_OPTIONS_PATH:-/data/options.json}"
modbus_guard="${HELIANTHUS_MODBUS_RUNTIME_GUARD:-/usr/share/helianthus/modbus_runtime_guard.py}"
modbus_endpoint_file="${HELIANTHUS_MODBUS_ENDPOINT_FILE:-/run/helianthus/modbus-endpoint}"
modbus_eval_file=""
modbus_endpoint_staging=""
modbus_pre_exec_signal=""
cleanup_modbus_pre_exec() {
  rm -f -- "${modbus_endpoint_file}" || true
  if [ -n "${modbus_eval_file}" ]; then
    rm -f -- "${modbus_eval_file}" || true
  fi
  if [ -n "${modbus_endpoint_staging}" ]; then
    rm -f -- "${modbus_endpoint_staging}" || true
  fi
}
abort_modbus_pre_exec_on_signal() {
  case "${modbus_pre_exec_signal}" in
    TERM) exit 143 ;;
    INT) exit 130 ;;
  esac
}
trap cleanup_modbus_pre_exec EXIT
trap 'modbus_pre_exec_signal=TERM' TERM
trap 'modbus_pre_exec_signal=INT' INT

MODBUS_TCP_ENABLED=""
MODBUS_TCP_ENDPOINT=""
MODBUS_TCP_DIAL_TIMEOUT=""
if ! rm -f -- "${modbus_endpoint_file}"; then
  bashio::exit.nok "Unable to remove stale Modbus endpoint material"
fi
modbus_eval_file=$(mktemp /tmp/helianthus-modbus-validate.XXXXXX) || \
  bashio::exit.nok "Unable to create the Modbus validation result file"
chmod 0600 "${modbus_eval_file}" || \
  bashio::exit.nok "Unable to protect the Modbus validation result file"
modbus_validation_status=0
python3 "${modbus_guard}" validate \
  --options "${modbus_options_path}" > "${modbus_eval_file}" || \
  modbus_validation_status=$?
abort_modbus_pre_exec_on_signal
if [ "${modbus_validation_status}" -eq 0 ]; then
  modbus_eval=$(<"${modbus_eval_file}")
  rm -f -- "${modbus_eval_file}"
  modbus_eval_file=""
  eval "${modbus_eval}"
else
  bashio::exit.nok "Modbus TCP options failed atomic validation; endpoint remains redacted"
fi
case "${MODBUS_TCP_ENABLED}" in
  true | false) ;;
  *) bashio::exit.nok "Modbus TCP validator returned an incomplete result" ;;
esac
modbus_tcp_enabled="${MODBUS_TCP_ENABLED}"
modbus_tcp_dial_timeout="${MODBUS_TCP_DIAL_TIMEOUT}"
if [ "${modbus_tcp_enabled}" = "true" ]; then
  modbus_endpoint_dir="${modbus_endpoint_file%/*}"
  if [ "${modbus_endpoint_dir}" = "${modbus_endpoint_file}" ]; then
    bashio::exit.nok "Modbus endpoint file must include a parent directory"
  fi
  mkdir -p -- "${modbus_endpoint_dir}"
  abort_modbus_pre_exec_on_signal
  chmod 0700 "${modbus_endpoint_dir}"
  abort_modbus_pre_exec_on_signal
  modbus_endpoint_staging="${modbus_endpoint_file}.tmp.$$"
  rm -f -- "${modbus_endpoint_staging}"
  abort_modbus_pre_exec_on_signal
  umask 077
  printf '%s' "${MODBUS_TCP_ENDPOINT}" > "${modbus_endpoint_staging}"
  abort_modbus_pre_exec_on_signal
  chmod 0600 "${modbus_endpoint_staging}"
  abort_modbus_pre_exec_on_signal
  mv -f -- "${modbus_endpoint_staging}" "${modbus_endpoint_file}"
  abort_modbus_pre_exec_on_signal
fi
trap 'exit 143' TERM
trap 'exit 130' INT
abort_modbus_pre_exec_on_signal
unset MODBUS_TCP_ENDPOINT modbus_eval modbus_validation_status modbus_pre_exec_signal

# Validate protected eeBUS values before bashio captures them. Bash command
# substitution cannot preserve NUL, and textual bashio output cannot retain
# JSON scalar types, so validation after capture would be too late.
eebus_options_path="/data/options.json"
eebus_validate_protected_option() {
  local key expected_type
  key="$1"
  expected_type="$2"
  if ! jq -e --arg key "${key}" 'has($key) and .[$key] != null' \
    "${eebus_options_path}" >/dev/null 2>&1; then
    return 0
  fi
  case "${expected_type}" in
    boolean)
      jq -e --arg key "${key}" '.[ $key ] | type == "boolean"' \
        "${eebus_options_path}" >/dev/null 2>&1 || \
        bashio::exit.nok "eeBUS option ${key} has an invalid protected JSON value or type"
      ;;
    integer)
      jq -e --arg key "${key}" '.[ $key ] | type == "number" and floor == .' \
        "${eebus_options_path}" >/dev/null 2>&1 || \
        bashio::exit.nok "eeBUS option ${key} has an invalid protected JSON value or type"
      ;;
    string)
      jq -e --arg key "${key}" \
        '.[ $key ] | type == "string" and (index("\u0000") == null)' \
        "${eebus_options_path}" >/dev/null 2>&1 || \
        bashio::exit.nok "eeBUS option ${key} has an invalid protected JSON value or type"
      ;;
  esac
}

if [ -f "${eebus_options_path}" ]; then
  if ! command -v jq >/dev/null 2>&1 || ! jq -e 'type == "object"' "${eebus_options_path}" >/dev/null 2>&1; then
    bashio::exit.nok "eeBUS protected options must be a valid JSON object"
  fi
  eebus_validate_protected_option eebus_enabled boolean
  eebus_validate_protected_option eebus_listen_port integer
  eebus_validate_protected_option eebus_interface string
  eebus_validate_protected_option eebus_subnets string
  eebus_validate_protected_option eebus_discovery_enabled boolean
  eebus_validate_protected_option eebus_remote_ski_allowlist string
fi

eebus_enabled=$(bashio::config 'eebus_enabled' 2>/dev/null || true)
eebus_listen_port=$(bashio::config 'eebus_listen_port' 2>/dev/null || true)
eebus_interface=$(bashio::config 'eebus_interface' 2>/dev/null || true)
eebus_subnets=$(bashio::config 'eebus_subnets' 2>/dev/null || true)
eebus_discovery_enabled=$(bashio::config 'eebus_discovery_enabled' 2>/dev/null || true)
eebus_remote_ski_allowlist=$(bashio::config 'eebus_remote_ski_allowlist' 2>/dev/null || true)

# An in-place upgrade can briefly expose the previous Supervisor schema even
# though /data/options.json already contains the new eeBUS keys. Recover only
# missing eeBUS values from the protected options file; all recovered values
# still pass through the same validation below.
eebus_option_fallback() {
  local key expected_type
  key="$1"
  expected_type="$2"
  if [ ! -f "${eebus_options_path}" ] || ! command -v jq >/dev/null 2>&1; then
    return 1
  fi
  if ! jq -e 'type == "object"' "${eebus_options_path}" >/dev/null 2>&1; then
    return 2
  fi
  if ! jq -e --arg key "${key}" 'has($key) and .[$key] != null' \
    "${eebus_options_path}" >/dev/null 2>&1; then
    return 1
  fi
  case "${expected_type}" in
    boolean)
      jq -e --arg key "${key}" '.[ $key ] | type == "boolean"' \
        "${eebus_options_path}" >/dev/null 2>&1 || return 2
      ;;
    integer)
      jq -e --arg key "${key}" '.[ $key ] | type == "number" and floor == .' \
        "${eebus_options_path}" >/dev/null 2>&1 || return 2
      ;;
    string)
      jq -e --arg key "${key}" \
        '.[ $key ] | type == "string" and (index("\u0000") == null)' \
        "${eebus_options_path}" >/dev/null 2>&1 || return 2
      ;;
    *)
      return 2
      ;;
  esac
  jq -r --arg key "${key}" '.[ $key ]' "${eebus_options_path}"
}

eebus_fallback_used=false
eebus_enabled_from_options_file=false
eebus_listen_port_from_options_file=false
eebus_interface_from_options_file=false
eebus_subnets_from_options_file=false
eebus_discovery_enabled_from_options_file=false
eebus_remote_ski_allowlist_from_options_file=false

eebus_resolve_missing_option() {
  local variable key expected_type current resolved rc
  variable="$1"
  key="$2"
  expected_type="$3"
  current="${!variable}"
  if [ -n "${current}" ] && [ "${current}" != "null" ]; then
    return 0
  fi
  if resolved=$(eebus_option_fallback "${key}" "${expected_type}"); then
    printf -v "${variable}" '%s' "${resolved}"
    printf -v "${variable}_from_options_file" '%s' true
    if [ "${resolved}" != "${current}" ] || [ "${current}" = "null" ]; then
      eebus_fallback_used=true
    fi
    return 0
  else
    rc=$?
  fi
  if [ "${rc}" -eq 2 ]; then
    bashio::exit.nok "eeBUS option ${key} has an invalid protected JSON value or type"
  fi
}

eebus_resolve_missing_option eebus_enabled eebus_enabled boolean
eebus_resolve_missing_option eebus_listen_port eebus_listen_port integer
eebus_resolve_missing_option eebus_interface eebus_interface string
eebus_resolve_missing_option eebus_subnets eebus_subnets string
eebus_resolve_missing_option eebus_discovery_enabled eebus_discovery_enabled boolean
eebus_resolve_missing_option eebus_remote_ski_allowlist eebus_remote_ski_allowlist string
if bashio::var.true "${eebus_fallback_used}"; then
  bashio::log.warning "Supervisor schema omitted configured eeBUS values; recovered missing fields from protected /data/options.json"
fi

# Apply defaults when Supervisor has not yet merged new config schema keys.
if [ -z "${observe_first_enabled}" ] || [ "${observe_first_enabled}" = "null" ]; then
  observe_first_enabled=true
fi
if [ -z "${passive_state_direct_apply}" ] || [ "${passive_state_direct_apply}" = "null" ]; then
  passive_state_direct_apply=true
fi
if [ -z "${passive_config_direct_apply}" ] || [ "${passive_config_direct_apply}" = "null" ]; then
  passive_config_direct_apply=false
fi
if [ -z "${external_write_policy}" ] || [ "${external_write_policy}" = "null" ]; then
  external_write_policy="record_only"
fi
if [ -z "${enable_static_seed_table}" ] || [ "${enable_static_seed_table}" = "null" ]; then
  enable_static_seed_table=false
fi
# v8 classifier mode default: "enforce" as of addon 0.6.23
# (2026-05-21). Per the shadow→enforce promotion gate procedure in
# helianthus-docs-ebus/deployment/prometheus-alerts.md, the live HA
# host validation (_work_adaptermux_audit/v8-shadow-validation-*) at
# iter-7 confirmed 100% true-positive AA-injection signal under
# shadow mode (every flagged byte was canonical raw-wire 0xAA mid-
# telegram, with WasEscaped=false — the textbook AA-injection
# pattern). Zero false-positives observed across multiple sustained
# observation windows. Enforcing the filter for new installs removes
# ~3 bytes/s of validated wire garbage from cross-proxy byte streams.
#
# In-place upgrade contract: existing addon installations whose
# /data/options.json explicitly sets `v8_classifier_mode` to "off"
# or "shadow" are NOT affected by this default change — bashio reads
# the option value, the fallback only fires when the key is unset.
# Operators wanting to opt out of enforce mode for their own
# installation must explicitly set v8_classifier_mode=off or shadow
# in the addon options before/after upgrade.
if [ -z "${v8_classifier_mode}" ] || [ "${v8_classifier_mode}" = "null" ]; then
  v8_classifier_mode="enforce"
fi
if [ -z "${eebus_enabled}" ] || { [ "${eebus_enabled}" = "null" ] && [ "${eebus_enabled_from_options_file}" != true ]; }; then
  eebus_enabled=false
fi
if [ -z "${eebus_listen_port}" ] || { [ "${eebus_listen_port}" = "null" ] && [ "${eebus_listen_port_from_options_file}" != true ]; }; then
  eebus_listen_port=4712
fi
if [ -z "${eebus_interface}" ] || { [ "${eebus_interface}" = "null" ] && [ "${eebus_interface_from_options_file}" != true ]; }; then
  eebus_interface=""
fi
if [ -z "${eebus_subnets}" ] || { [ "${eebus_subnets}" = "null" ] && [ "${eebus_subnets_from_options_file}" != true ]; }; then
  eebus_subnets=""
fi
if [ -z "${eebus_discovery_enabled}" ] || { [ "${eebus_discovery_enabled}" = "null" ] && [ "${eebus_discovery_enabled_from_options_file}" != true ]; }; then
  eebus_discovery_enabled=true
fi
if [ -z "${eebus_remote_ski_allowlist}" ] || { [ "${eebus_remote_ski_allowlist}" = "null" ] && [ "${eebus_remote_ski_allowlist_from_options_file}" != true ]; }; then
  eebus_remote_ski_allowlist=""
fi
case "${eebus_enabled}" in
  true | false) ;;
  *) bashio::exit.nok "eeBUS requires eebus_enabled to be boolean true or false" ;;
esac
case "${eebus_discovery_enabled}" in
  true | false) ;;
  *) bashio::exit.nok "eeBUS requires eebus_discovery_enabled to be boolean true or false" ;;
esac
# Export so the gateway binary's startup wiring (cmd/gateway/main.go
# os.Getenv(v8classifier.EnvVarName)) reads it. ParseMode validates
# the value; unrecognized values cause log.Fatalf at startup so
# operators see typos immediately.
export HELIANTHUS_V8_CLASSIFIER_MODE="${v8_classifier_mode}"
if [ -z "${adapter_direct_enabled}" ] || [ "${adapter_direct_enabled}" = "null" ]; then
  adapter_direct_enabled=false
fi
if [ -z "${adapter_direct_address}" ] || [ "${adapter_direct_address}" = "null" ]; then
  adapter_direct_address=""
fi
adapter_direct_protocol=$(printf '%s' "${adapter_direct_protocol}" | tr '[:upper:]' '[:lower:]' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
if [ -z "${adapter_direct_protocol}" ] || [ "${adapter_direct_protocol}" = "null" ]; then
  adapter_direct_protocol="enh"
fi
case "${adapter_direct_protocol}" in
  enh | ens) ;;
  *) bashio::exit.nok "adapter_direct_protocol must be one of: enh, ens" ;;
esac
if [ "${proxy_listen_addr}" = "null" ]; then
  proxy_listen_addr="0.0.0.0:19001"
fi
instance_guid_file="/data/instance_guid"
legacy_source_addr_last_file="/data/source_addr.last"

normalize_instance_guid() {
	local raw normalized
	raw="$1"
	normalized=$(printf '%s' "${raw}" | tr '[:upper:]' '[:lower:]' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
	if [ -z "${normalized}" ]; then
		return 1
	fi
	if [[ "${normalized}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]]; then
		printf '%s' "${normalized}"
		return 0
	fi
	return 1
}

load_instance_guid_state() {
	if [ ! -f "${instance_guid_file}" ]; then
		return 1
	fi

	local stored
	stored=$(head -n 1 "${instance_guid_file}" 2>/dev/null || true)
	if [ -z "${stored}" ]; then
		return 1
	fi

	normalize_instance_guid "${stored}"
}

persist_instance_guid_state() {
	local value tmp dir
	value="$1"
	if [ -z "${value}" ]; then
		return 1
	fi

	dir=$(dirname "${instance_guid_file}")
	tmp="${instance_guid_file}.tmp"

	mkdir -p "${dir}" 2>/dev/null || return 1
	if printf '%s\n' "${value}" >"${tmp}" 2>/dev/null; then
		mv -f "${tmp}" "${instance_guid_file}" 2>/dev/null || return 1
	fi
	rm -f "${tmp}" 2>/dev/null || true
	return 0
}

generate_instance_guid() {
	local generated
	generated=""
	if [ -r /proc/sys/kernel/random/uuid ]; then
		generated=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || true)
	fi
	normalize_instance_guid "${generated}"
}

effective_transport="${transport}"
effective_network="${network}"
effective_address="${address}"

proxy_profile=$(printf '%s' "${proxy_profile}" | tr '[:upper:]' '[:lower:]')
proxy_endpoint_trimmed=$(printf '%s' "${proxy_endpoint}" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
if bashio::var.true "${adapter_direct_enabled}" && [ -n "${proxy_endpoint_trimmed}" ]; then
  bashio::exit.nok "adapter_direct_enabled=true requires proxy_endpoint to be empty"
fi

case "${proxy_profile}" in
  "" | disabled)
    proxy_profile="disabled"
    ;;
  enh | ens)
    if bashio::var.true "${adapter_direct_enabled}"; then
      # Compatibility migration for pre-selector installs. The old wrapper
      # used proxy_profile as the accidental adapter-direct ENS/ENH selector;
      # those configurations have no proxy endpoint. Consume that exact legacy
      # shape, then disable the effective proxy profile so normal adapter-direct
      # routing remains owned solely by adapter_direct_protocol.
      bashio::log.warning "Migrating legacy adapter-direct proxy_profile=${proxy_profile} to adapter_direct_protocol=${proxy_profile}; save adapter_direct_protocol=${proxy_profile} and proxy_profile=disabled in add-on options"
      adapter_direct_protocol="${proxy_profile}"
      proxy_profile="disabled"
    else
      if [ -z "${proxy_endpoint_trimmed}" ]; then
        bashio::exit.nok "proxy_endpoint is required when proxy_profile=${proxy_profile}"
      fi
      if [[ "${proxy_endpoint_trimmed}" == *"://"* ]]; then
        effective_address="${proxy_endpoint_trimmed}"
      else
        effective_address="${proxy_profile}://${proxy_endpoint_trimmed}"
      fi
      effective_transport="${proxy_profile}"
      effective_network="tcp"
    fi
    ;;
  *)
    bashio::exit.nok "proxy_profile must be one of: disabled, enh, ens"
    ;;
esac

proxy_endpoint_marker="(none)"
if [ -n "${proxy_endpoint_trimmed}" ]; then
  proxy_endpoint_marker="${proxy_endpoint_trimmed}"
fi
if [ "${proxy_profile}" = "enh" ] || [ "${proxy_profile}" = "ens" ]; then
  proxy_endpoint_marker="${effective_address}"
fi

# adapter-direct mode: override transport to adapter-direct:// URI
if bashio::var.true "${adapter_direct_enabled}"; then
  # Strip whitespace, then strip any scheme prefix (ens://, enh://, adapter-direct://)
  # for compatibility. The typed adapter_direct_protocol option remains the
  # only authority for selecting ENH versus ENS.
  adapter_direct_address_trimmed=$(printf '%s' "${adapter_direct_address}" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s|^[a-zA-Z][-a-zA-Z0-9]*://||')
  if [ -z "${adapter_direct_address_trimmed}" ]; then
    bashio::exit.nok "adapter_direct_address is required when adapter_direct_enabled=true"
  fi
  if [ "${adapter_direct_protocol}" = "ens" ]; then
    effective_address="adapter-direct-ens://${adapter_direct_address_trimmed}"
  else
    effective_address="adapter-direct://${adapter_direct_address_trimmed}"
  fi
  effective_transport="adapter-direct"
  effective_network="tcp"
fi

if [ -z "${http_port}" ]; then
  http_port=8080
fi

if [ -n "${port}" ] && { [ "${http_port}" = "8080" ] || [ "${port}" != "8080" ]; }; then
  http_port="${port}"
fi

if [ -z "${path}" ]; then
  path="${graphql_path}"
fi

if [ -n "${path}" ] && { [ "${graphql_path}" = "/graphql" ] || [ "${path}" != "/graphql" ]; }; then
  graphql_path="${path}"
fi

if [ -z "${host}" ]; then
  host="127.0.0.1"
fi

if [ "${graphql_path#/}" = "${graphql_path}" ]; then
  graphql_path="/${graphql_path}"
fi

if [ "${subscription_path#/}" = "${subscription_path}" ]; then
  subscription_path="/${subscription_path}"
fi

if [ "${mcp_path#/}" = "${mcp_path}" ]; then
  mcp_path="/${mcp_path}"
fi

if [ "${subscription_path}" = "/graphql/subscriptions" ] && [ "${graphql_path}" != "/graphql" ]; then
  subscription_path="${graphql_path%/}/subscriptions"
fi

http_addr="0.0.0.0:${http_port}"

if [ -z "${scan_request_timeout}" ]; then
  scan_request_timeout="400ms"
fi

# Resolve instance_guid via the Python wrapper (M6_HA_ADDON_MIGRATION).
# The wrapper implements AD09a/b/26/27 of runtime-state-w19-26.locked:
#   - AD09b read precedence (runtime_state.json valid → use; legacy detected
#     without migration → AD09a halt; both absent → generate fresh).
#   - AD09a halt: marker file at /data/.helianthus_migration_required +
#     HELIANTHUS_MIGRATION_REQUIRED log token + exit 1 (NOT sysexits-78 per
#     consultant MF-1).
#   - AD25 HELIANTHUS_FRESH_IDENTITY warn on case 3.
#   - AD26 bounded ENOENT retries on runtime_state.json read.
#   - AD27 emits HELIANTHUS_INSTANCE_GUID_SOURCE for the gateway flag.
#
# The wrapper writes structured logs to stderr and eval-able key=value lines
# to stdout. Invoke ONCE and capture stdout for eval; stderr streams through
# to Supervisor logs. The earlier two-invocation form was broken: it ran the
# resolver twice (generating two different UUIDs in case 3) and the
# `2>&1 >/dev/null` redirect captured stderr into the eval text, so a fresh
# install tried to eval the warning banner and exited under set -e.
wrapper_script="${HELIANTHUS_RUNTIME_STATE_WRAPPER:-/usr/share/helianthus/check_runtime_state_wrapper.py}"
if wrapper_eval=$(python3 "${wrapper_script}"); then
  eval "${wrapper_eval}"
else
  rc=$?
  if [ "${rc}" -eq 1 ]; then
    bashio::log.error "Helianthus migration required — see /data/.helianthus_migration_required"
    exit 1
  fi
  bashio::exit.nok "runtime-state wrapper failed with exit code ${rc}"
fi
instance_guid="${HELIANTHUS_INSTANCE_GUID:-}"
instance_guid_source="${HELIANTHUS_INSTANCE_GUID_SOURCE:-}"
if [ -z "${instance_guid}" ]; then
  bashio::exit.nok "runtime-state wrapper did not emit HELIANTHUS_INSTANCE_GUID"
fi
bashio::log.info "Helianthus instance GUID ${instance_guid} (source=${instance_guid_source})"

bashio::log.info "Starting Helianthus gateway"
bashio::log.info "Transport: ${effective_transport} (${effective_network} ${effective_address})"
bashio::log.info "Proxy profile: ${proxy_profile}"
bashio::log.info "Proxy endpoint: ${proxy_endpoint_marker}"
proxy_listen_args=()
if bashio::var.true "${adapter_direct_enabled}"; then
  bashio::log.info "Adapter-direct: enabled=${adapter_direct_enabled} protocol=${adapter_direct_protocol} address=${adapter_direct_address}"
  if [ -n "${proxy_listen_addr}" ]; then
    proxy_listen_args=(-proxy-listen "${proxy_listen_addr}")
    bashio::log.info "Proxy listener: ${proxy_listen_addr}"
  fi
fi
bashio::log.info "HTTP listen: ${http_addr}"
bashio::log.info "GraphQL endpoint: http://${host}:${http_port}${graphql_path}"
bashio::log.info "Subscriptions endpoint: http://${host}:${http_port}${subscription_path}"
bashio::log.info "MCP endpoint: http://${host}:${http_port}${mcp_path}"
bashio::log.info "mDNS: enabled=${mdns} instance=${mdns_instance}"
bashio::log.info "Stable instance GUID: ${instance_guid}"
bashio::log.info "Observe-first: enabled=${observe_first_enabled} state-direct-apply=${passive_state_direct_apply} config-direct-apply=${passive_config_direct_apply} write-policy=${external_write_policy}"
bashio::log.info "Static seed table: enabled=${enable_static_seed_table} (productids NETX3 0xF1/0xF6/0x04/0xFF + BASV2 0x15/0xEC)"
bashio::log.info "v8 classifier mode: ${v8_classifier_mode} (HELIANTHUS_V8_CLASSIFIER_MODE — off=zero-overhead, shadow=canary, enforce=production filtering [addon default since 0.6.23])"

gateway_bin="/usr/local/bin/helianthus-gateway"
if [ -e "/data/helianthus-gateway" ] || [ -L "/data/helianthus-gateway" ]; then
  bashio::exit.nok "Persistent gateway binary override is not supported by this authoritative release; remove /data/helianthus-gateway before startup"
fi
binary_supports_flag() {
  local binary flag output
  binary="$1"
  flag="$2"
  output=$("${binary}" --help 2>&1 || true)
  printf '%s\n' "${output}" | grep -Eq -- "(^|[[:space:]])-${flag}([[:space:],=]|$)"
}

gateway_supports_flag() {
  binary_supports_flag "${gateway_bin}" "$1"
}

# Gate `-enable-static-seed-table` on gateway support — the flag is
# only present in builds containing P3 wiring. Older pinned gateway
# binaries would fail flag parsing at startup. (Codex P1+P2 follow-up
# on PR #124, 2026-05-08:
# this block must run AFTER gateway_bin selection + gateway_supports_flag
# definition, otherwise the function call resolves to "command not
# found" and the conditional is always false.)
static_seed_args=()
if gateway_supports_flag "enable-static-seed-table"; then
  static_seed_args=(-enable-static-seed-table="${enable_static_seed_table}")
elif bashio::var.true "${enable_static_seed_table}"; then
  bashio::log.warning "enable_static_seed_table=true requested but the packaged gateway binary does not support -enable-static-seed-table; flag ignored. Publish an add-on release with a gateway that includes the P3 patch."
fi

semantic_cache_args=()
if gateway_supports_flag "semantic-cache-path"; then
  semantic_cache_args=(-semantic-cache-path "/data/semantic_cache.json")
  bashio::log.info "Semantic cache path: /data/semantic_cache.json"
else
  bashio::log.warning "Packaged gateway binary does not support -semantic-cache-path; semantic startup cache will remain container-local. Publish an add-on release with gateway semantic cache persistence support."
fi

eebus_args=()
if bashio::var.true "${eebus_enabled}"; then
  eebus_interface=$(printf '%s' "${eebus_interface}" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
  eebus_subnets=$(printf '%s' "${eebus_subnets}" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
  eebus_remote_ski_allowlist=$(printf '%s' "${eebus_remote_ski_allowlist}" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')

  if ! [[ "${eebus_listen_port}" =~ ^[0-9]+$ ]] || [ "$((10#${eebus_listen_port}))" -lt 1 ] || [ "$((10#${eebus_listen_port}))" -gt 65535 ]; then
    bashio::exit.nok "eeBUS requires eebus_listen_port in the range 1..65535"
  fi
  if [ -z "${eebus_interface}" ]; then
    bashio::exit.nok "eeBUS requires one explicit eebus_interface"
  fi
  if [[ "${eebus_interface}" == *,* ]] || ! [[ "${eebus_interface}" =~ ^[A-Za-z0-9_.:-]+$ ]]; then
    bashio::exit.nok "eeBUS requires exactly one eebus_interface"
  fi
  if [ -z "${eebus_subnets}" ]; then
    bashio::exit.nok "eeBUS requires a non-empty eebus_subnets prefix list"
  fi
  if [ -n "${eebus_remote_ski_allowlist}" ]; then
    IFS=',' read -r -a eebus_remote_ski_entries <<< "${eebus_remote_ski_allowlist}"
    for eebus_remote_ski in "${eebus_remote_ski_entries[@]}"; do
      eebus_remote_ski=$(printf '%s' "${eebus_remote_ski}" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
      if ! [[ "${eebus_remote_ski}" =~ ^[0-9A-Fa-f]{40}$ ]]; then
        bashio::exit.nok "eeBUS requires every allowlist entry to be a 40-hex SKI"
      fi
    done
  fi

  missing_eebus_flags=()
  for required_flag in \
    eebus-enabled \
    eebus-listen-port \
    eebus-interfaces \
    eebus-subnets \
    eebus-state-root \
    eebus-discovery-enabled \
    eebus-remote-ski-allowlist \
    eebus-pairing-window-mode; do
    if ! gateway_supports_flag "${required_flag}"; then
      missing_eebus_flags+=("${required_flag}")
    fi
  done
  if [ "${#missing_eebus_flags[@]}" -ne 0 ]; then
    bashio::exit.nok "gateway does not support the complete eeBUS runtime flag set"
  fi

  interface_id_path="/sys/class/net/${eebus_interface}/address"
  if [ ! -r "${interface_id_path}" ]; then
    bashio::exit.nok "eeBUS cannot read the configured interface identity"
  fi
  interface_id=$(tr -d ':\r\n' < "${interface_id_path}" | tr '[:upper:]' '[:lower:]')
  if ! [[ "${interface_id}" =~ ^[0-9a-f]{12}$ ]]; then
    bashio::exit.nok "eeBUS configured interface identity is invalid"
  fi
  machine_id=$(printf 'helianthus-eebusreg-ha-v1:%s' "${interface_id}" | sha256sum | awk '{print $1}')
  printf '%s\n' "${machine_id}" > /etc/machine-id
  chmod 0444 /etc/machine-id

  if bashio::var.true "${eebus_discovery_enabled}"; then
    eebus_discovery_value=true
  else
    eebus_discovery_value=false
  fi
  eebus_args=(
    -eebus-enabled=true
    -eebus-listen-port "${eebus_listen_port}"
    -eebus-interfaces "${eebus_interface}"
    -eebus-subnets "${eebus_subnets}"
    -eebus-state-root "/data/eebus"
    -eebus-discovery-enabled="${eebus_discovery_value}"
    -eebus-remote-ski-allowlist "${eebus_remote_ski_allowlist}"
    -eebus-pairing-window-mode "closed"
  )
  bashio::log.info "eeBUS runtime: enabled on ${eebus_interface}:${eebus_listen_port}, pairing closed"
else
  bashio::log.info "eeBUS runtime: disabled"
fi

modbus_args=()
if bashio::var.true "${modbus_tcp_enabled}"; then
  missing_modbus_flags=()
  for required_flag in modbus-tcp-enabled modbus-tcp-endpoint-file modbus-tcp-dial-timeout; do
    if ! gateway_supports_flag "${required_flag}"; then
      missing_modbus_flags+=("${required_flag}")
    fi
  done
  if [ "${#missing_modbus_flags[@]}" -ne 0 ]; then
    bashio::exit.nok "gateway does not support the complete Modbus TCP runtime flag set"
  fi
  modbus_args=(
    -modbus-tcp-enabled=true
    -modbus-tcp-endpoint-file "${modbus_endpoint_file}"
    -modbus-tcp-dial-timeout "${modbus_tcp_dial_timeout}"
  )
  bashio::log.info "Modbus TCP runtime: enabled"
else
  bashio::log.info "Modbus TCP runtime: disabled"
fi

# Gate `-instance-guid-source` (AD27) on gateway support. The pinned gateway
# version in Dockerfile/build.yml emits this flag as part of M2_GATEWAY_LOADER.
# The compatibility gate preserves identity continuity if a future packaged
# binary temporarily lacks the provenance-tagging flag. (Codex P2 follow-up
# on PR #127.)
instance_guid_source_args=()
if gateway_supports_flag "instance-guid-source"; then
  instance_guid_source_args=(-instance-guid-source "${instance_guid_source}")
else
  bashio::log.warning "Packaged gateway binary does not support -instance-guid-source; identity provenance tag (${instance_guid_source}) will not be propagated. Publish an add-on release with a gateway that includes the M2_GATEWAY_LOADER patch."
fi

source_addr_normalized=$(printf '%s' "${source_addr}" | tr '[:upper:]' '[:lower:]' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
source_addr_intent=$(printf '%s' "${source_addr}" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
source_addr_args=()

if [ "${source_addr_normalized}" = "auto" ] || [ "${source_addr_normalized}" = "null" ] || [ -z "${source_addr_normalized}" ]; then
  if [ -f "${legacy_source_addr_last_file}" ]; then
    bashio::log.info "Legacy source address state file ${legacy_source_addr_last_file} is retained for rollback only; source_addr=auto uses gateway default source selection"
  fi
  if [ "${effective_transport}" = "ebusd-tcp" ]; then
    bashio::log.info "source_addr=auto with transport=ebusd-tcp; using gateway default ebusd-compatible source selection"
  else
    bashio::log.info "source_addr=auto; using gateway default source-selection policy"
  fi
  source_addr_args=(-source-addr "auto")
elif [ "${effective_transport}" = "ebusd-tcp" ]; then
  bashio::log.info "source_addr=${source_addr_intent} with transport=ebusd-tcp; using ebusd-compatible gateway source input"
  if [ -f "${legacy_source_addr_last_file}" ]; then
    bashio::log.info "Legacy source address state file ${legacy_source_addr_last_file} is retained for rollback only; explicit ebusd-tcp source_addr does not rewrite it"
  fi
  source_addr_args=(-source-addr "${source_addr_intent}")
elif gateway_supports_flag "startup-source-override" && gateway_supports_flag "startup-source-override-validate"; then
  bashio::log.info "source_addr=${source_addr_intent}; using validate-only gateway startup source override"
  if [ -f "${legacy_source_addr_last_file}" ]; then
    bashio::log.info "Legacy source address state file ${legacy_source_addr_last_file} is retained for rollback only; explicit source_addr does not rewrite it"
  fi
  source_addr_args=(-startup-source-override "${source_addr_intent}" -startup-source-override-validate=true)
else
  bashio::exit.nok "source_addr=${source_addr_intent} requires gateway startup source override validation support; upgrade helianthus-gateway or set source_addr=auto"
fi

gateway_common_args=(
  -transport "${effective_transport}"
  -network "${effective_network}"
  -address "${effective_address}"
)
if [ "${#eebus_args[@]}" -ne 0 ]; then gateway_common_args+=("${eebus_args[@]}"); fi
gateway_common_args+=(
  "${source_addr_args[@]}"
  -scan-request-timeout "${scan_request_timeout}"
  -http-addr "${http_addr}"
  -graphql-path "${graphql_path}"
  -subscription-path "${subscription_path}"
  -mcp-path "${mcp_path}"
  -mdns="${mdns}"
  -mdns-instance "${mdns_instance}"
  -instance-guid "${instance_guid}"
)
gateway_args=("${gateway_common_args[@]}")
if [ "${#instance_guid_source_args[@]}" -ne 0 ]; then gateway_args+=("${instance_guid_source_args[@]}"); fi
gateway_args+=(
  -broadcast="${broadcast}"
  -read-timeout "${read_timeout}"
  -write-timeout "${write_timeout}"
  -dial-timeout "${dial_timeout}"
  -observe-first-enabled="${observe_first_enabled}"
  -passive-state-direct-apply="${passive_state_direct_apply}"
  -passive-config-direct-apply="${passive_config_direct_apply}"
  -external-write-policy "${external_write_policy}"
)
if [ "${#static_seed_args[@]}" -ne 0 ]; then gateway_args+=("${static_seed_args[@]}"); fi
if [ "${#semantic_cache_args[@]}" -ne 0 ]; then gateway_args+=("${semantic_cache_args[@]}"); fi
if [ "${#proxy_listen_args[@]}" -ne 0 ]; then gateway_args+=("${proxy_listen_args[@]}"); fi

if bashio::var.true "${modbus_tcp_enabled}"; then
  gateway_args+=("${modbus_args[@]}")
fi

exec "${gateway_bin}" "${gateway_args[@]}"
